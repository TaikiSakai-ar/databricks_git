{
  "datasets": [
    {
      "name": "4e2c366b",
      "displayName": "no_purchase_counts",
      "queryLines": [
        "SELECT g.product_id,\n",
        "g.no_purchase_count,\n",
        "s.category,\n",
        "s.product_name\n",
        "FROM workspace.default.no_purchase_counts_gold g\n",
        "JOIN products_silver s\n",
        "ON g.product_id = s.product_id\n",
        "ORDER BY no_purchase_count DESC;"
      ]
    },
    {
      "name": "c4f3ed13",
      "displayName": "purchased_counts",
      "queryLines": [
        "\n",
        "SELECT MAX(g.product_id) AS product_id,\n",
        "    MAX(s.product_name) AS product_name,\n",
        "    MAX(s.category) AS category,\n",
        "    SUM(g.purchase_count) AS purchase_count\n",
        "FROM workspace.default.ordered_products_monthly_gold g\n",
        "JOIN products_silver s ON g.product_id = s.product_id\n",
        "GROUP BY g.product_id, s.product_name\n",
        "ORDER BY purchase_count DESC;"
      ]
    },
    {
      "name": "8968c0c8",
      "displayName": "product_click_counts",
      "queryLines": [
        "SELECT g.product_id,\n",
        "    s.product_name ,\n",
        "    SUM(g.click_count) AS click_count\n",
        "FROM workspace.default.clicked_products_monthly_gold g\n",
        "JOIN products_silver s ON g.product_id = s.product_id\n",
        "GROUP BY g.product_id, s.product_name\n",
        "ORDER BY click_count DESC;"
      ]
    },
    {
      "name": "9746cbb9",
      "displayName": "product_click_counts_per_month",
      "queryLines": [
        "SELECT \n",
        "  t.click_count,\n",
        "  t.product_id,\n",
        "  t.month,\n",
        "  p.product_name\n",
        "FROM (\n",
        "  SELECT *,\n",
        "    ROW_NUMBER() OVER (PARTITION BY month ORDER BY click_count DESC) AS rn\n",
        "  FROM workspace.default.clicked_products_monthly_gold\n",
        ") t\n",
        "JOIN workspace.default.products_silver p\n",
        "ON t.product_id = p.product_id\n",
        "WHERE t.rn <= 10\n",
        "ORDER BY t.month, t.click_count DESC;"
      ]
    },
    {
      "name": "f453ff79",
      "displayName": "Unique Product Categories Summary",
      "queryLines": [
        "SELECT category\n",
        "FROM products_silver\n",
        "GROUP BY category"
      ]
    }
  ],
